<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Deskwerk Sheets" Manufacturer="Deskwerk" Version="$(var.Version)" UpgradeCode="CA81A1E0-D901-45D0-9E16-8859F2B95AF8" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Deskwerk Sheets spreadsheet" Manufacturer="Deskwerk" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Deskwerk Sheets is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DeskwerkSheetsIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="DeskwerkSheetsIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/dicendy/deskwerk-sheets" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/dicendy/deskwerk-sheets/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/dicendy/deskwerk-sheets/issues" />

    <!-- Installer UI: the same wizard as Deskwerk Docs (installer-ui.wxi, shared verbatim):
         welcome, ready to install (with "Create a desktop shortcut"), progress, finish (with
         "Launch Deskwerk Sheets"). No licence page and no folder page. -->
    <?define AppName="Deskwerk Sheets" ?>
    <?define AppExeId="DeskwerkSheetsExe" ?>
    <?define InstallerKey="Software\Deskwerk\Sheets\Installer" ?>
    <?include $(sys.SOURCEFILEDIR)installer-ui.wxi?>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Deskwerk">
        <Directory Id="INSTALLFOLDER" Name="Sheets" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Deskwerk Sheets" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="DeskwerkSheetsFiles" />
    </Feature>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="DeskwerkSheetsFiles" Directory="INSTALLFOLDER">
      <Component Id="DeskwerkSheetsApp" Guid="BD076EFD-02B6-4F04-9E8A-0741AB0BBE42">
        <File Id="DeskwerkSheetsExe" Source="$(var.BinDir)\deskwerk-sheets.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Deskwerk Sheets" Description="Deskwerk Sheets spreadsheet" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="DeskwerkSheetsIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\deskwerk-sheets.exe" Value="[#DeskwerkSheetsExe]" Type="string" />

        <!-- ProgIds: how Explorer opens a file with Deskwerk Sheets. Nothing here sets HKCR\.<ext>'s
             default value, so the user's current default app is left alone. Files show the
             document icon (deskwerk-sheets-document.ico, installed next to the exe). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkSheets.Workbook" Value="Deskwerk Sheets Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkSheets.Workbook\DefaultIcon" Value="&quot;[#DeskwerkSheetsDocIcon]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkSheets.Workbook\shell\open\command" Value="&quot;[#DeskwerkSheetsExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkSheets.TextData" Value="Deskwerk Sheets Text Data" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkSheets.TextData\DefaultIcon" Value="&quot;[#DeskwerkSheetsDocIcon]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\DeskwerkSheets.TextData\shell\open\command" Value="&quot;[#DeskwerkSheetsExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with": Windows reads only the value names under OpenWithProgids; the data is
             ignored (WiX rejects an empty Value, so it repeats the ProgId). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsx\OpenWithProgids" Name="DeskwerkSheets.Workbook" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsm\OpenWithProgids" Name="DeskwerkSheets.Workbook" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xltx\OpenWithProgids" Name="DeskwerkSheets.Workbook" Value="DeskwerkSheets.Workbook" Type="string" />
        <!-- .xls, .xlsb and .ods are imported into a new workbook that saves as .xlsx. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\.xls\OpenWithProgids" Name="DeskwerkSheets.Workbook" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.xlsb\OpenWithProgids" Name="DeskwerkSheets.Workbook" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ods\OpenWithProgids" Name="DeskwerkSheets.Workbook" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.csv\OpenWithProgids" Name="DeskwerkSheets.TextData" Value="DeskwerkSheets.TextData" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tsv\OpenWithProgids" Name="DeskwerkSheets.TextData" Value="DeskwerkSheets.TextData" Type="string" />

        <!-- Settings > Default apps: lets the user pick Deskwerk Sheets for these types. -->
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities" Name="ApplicationName" Value="Deskwerk Sheets" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities" Name="ApplicationDescription" Value="Open-source spreadsheet for .xlsx, CSV and TSV files" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities\FileAssociations" Name=".xlsx" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities\FileAssociations" Name=".xlsm" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities\FileAssociations" Name=".xltx" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities\FileAssociations" Name=".xls" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities\FileAssociations" Name=".ods" Value="DeskwerkSheets.Workbook" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities\FileAssociations" Name=".csv" Value="DeskwerkSheets.TextData" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Capabilities\FileAssociations" Name=".tsv" Value="DeskwerkSheets.TextData" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="Deskwerk Sheets" Value="Software\Deskwerk\Sheets\Capabilities" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Document icon for the ProgIds' DefaultIcon (assets/app-icon/document.ico). -->
      <Component Id="DeskwerkSheetsDocIcon">
        <File Id="DeskwerkSheetsDocIcon" Source="$(sys.SOURCEFILEDIR)..\..\assets\app-icon\document.ico" Name="deskwerk-sheets-document.ico" KeyPath="yes" />
      </Component>

      <Component Id="DeskwerkSheetsCli">
        <File Id="DeskwerkSheetsCliExe" Source="$(var.BinDir)\deskwerk-sheets-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Persist both on and off, independently of the optional shortcut. AppSearch reads
           this before MajorUpgrade removes the previous product. -->
      <Component Id="DesktopShortcutPreference">
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Installer" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Deskwerk Sheets" Description="Deskwerk Sheets spreadsheet" Target="[#DeskwerkSheetsExe]" WorkingDirectory="INSTALLFOLDER" Icon="DeskwerkSheetsIcon.ico" IconIndex="0" />
        <!-- HKMU resolves to HKLM for this per-machine package, so another account can
             uninstall the marker too. MSI root -1 also satisfies ICE43 for this shortcut. -->
        <RegistryValue Root="HKMU" Key="Software\Deskwerk\Sheets\Installer" Name="DesktopShortcutComponent" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
