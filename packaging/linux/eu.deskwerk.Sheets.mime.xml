<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info for the formats Deskwerk Sheets opens. Every type below already ships with
     shared-mime-info on current distros; these entries only make sure the glob is known on
     minimal systems. The system's own definitions win where they exist. Each type also names
     the Deskwerk Sheets document icon (hicolor/scalable/mimetypes/eu.deskwerk.Sheets.document.svg),
     which file managers show for these files while the app is installed. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
    <comment>Office Open XML workbook</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.xlsx"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
  <mime-type type="application/vnd.ms-excel.sheet.macroEnabled.12">
    <comment>Office Open XML macro-enabled workbook</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.xlsm"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
  <mime-type type="application/vnd.openxmlformats-officedocument.spreadsheetml.template">
    <comment>Office Open XML workbook template</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.xltx"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
  <mime-type type="application/vnd.ms-excel">
    <comment>Excel 97-2003 workbook</comment>
    <glob pattern="*.xls"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
  <mime-type type="application/vnd.ms-excel.sheet.binary.macroEnabled.12">
    <comment>Excel binary workbook</comment>
    <glob pattern="*.xlsb"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
  <mime-type type="application/vnd.oasis.opendocument.spreadsheet">
    <comment>OpenDocument spreadsheet</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.ods"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
  <mime-type type="text/csv">
    <comment>CSV document</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.csv"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
  <mime-type type="text/tab-separated-values">
    <comment>TSV document</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.tsv"/>
    <icon name="eu.deskwerk.Sheets.document"/>
  </mime-type>
</mime-info>
